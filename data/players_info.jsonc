// ============================================================================
// Per-embed configuration for AutoFlix-CLI (JSONC: // comments allowed).
// Key = a fragment of the embed host, matched against the embed URL.
// ============================================================================
//
// type        Which extractor in scraping/player.py resolves the m3u8.
//             Values: default, sendvid, sibnet, uqload, vidoza, filemoon,
//             kakaflix, myvidplay, vidmoly, embed4me, veev, xtremestream,
//             montmyoboky, vidzy, voe.
//
// mode        DEFAULT MODE FOR EVERY PLAYER. "proxy" or "direct".
//             Optional (defaults to "proxy"). Kept for backward
//             compatibility, prefer "modes" below.
//
// modes       PER-PLAYER MODE, overrides "mode".
//             "modes": { "mpv": "direct", "vlc": "proxy" }
//             "proxy"  = stream through the local proxy (curl_cffi,
//                        browser-like TLS, retries, buffering). Works
//                        everywhere, but adds a layer of latency.
//             "direct" = hand the upstream URL + headers straight to the
//                        player. Faster and more stable for mpv, but the
//                        player must be able to fake the headers itself,
//                        which rules out Cloudflare-protected hosts.
//             Only "mpv" and "vlc" accept "direct"; a browser player always
//             goes through the proxy (no way to set a Referer on a <video>).
//             Use the "Test playback modes" dev tool to find what works,
//             then pin it here.
//
// referrer    Referer sent upstream. "full" = the whole embed page URL,
//             "path" = the host root, or any explicit URL string.
//
// alt-used    Add "Alt-Used: <embed domain>" (some CDNs need it).
//
// sec_headers Extra Sec-Fetch-* headers, as "Name: value;Name2: value2",
//             or true for the default iframe-like set. Unset means the
//             default iframe set is used in direct mode.
//
// no-header   Send no Referer/custom header at all. Widespread on mp4 hosts.
//
// ext         "mp4" when the stream is a progressive file, so the proxy
//             serves ranges correctly instead of rewriting a playlist.
//
// mpv_options Extra mpv CLI options, ONLY used in "direct" mode.
//             e.g. "mpv_options": ["--tls-verify=no"]
//
// url-replacements   String replacements applied to the decoded page.
// ============================================================================

{
  "wishonly": {
    "type": "default",
    "referrer": "full",
    "alt-used": true,
    "sec_headers": "Sec-Fetch-Dest:empty;Sec-Fetch-Mode:cors;Sec-Fetch-Site:cross-site;Content-Cache: no-cache",
    "mode": "proxy",
  },
  "hgbazooka": { "type": "default" },
  "hailindihg": { "type": "default" },
  "gradehgplus": { "type": "default" },
  "taylorplayer": { "type": "default" },
  "vidmoly": { "type": "vidmoly", "modes": { "mpv": "direct" } },
  // "oneupload": { "type": "default" },
  "tipfly": { "type": "default" },
  "lulustream": {
    "type": "default",
    "url-replacements": { "cdn-tnmr": "tnmr" },
  },
  "luluvdo": {"type": "default"},
  "luluvdoo": {"type": "default"},
  "luluvid": {"type": "default"},
  "ups2up": { "type": "default" },
  "ico3c": { "type": "default" },
  "fsvid": {
    "type": "default",
    "no-header": true,
  },
  "darkibox": { "type": "default" },
  "minochinos": { "type": "default", "modes": { "mpv": "direct" } },
  "movearnpre": {
    "type": "default",
    "referrer": "full",
    "alt-used": false,
    "sec_headers": "Sec-Fetch-Dest:empty;Sec-Fetch-Mode:cors;Sec-Fetch-Site:same-origin",
  },
  "smoothpre": {
    "type": "default",
    "referrer": "full",
    "alt-used": true,
    "sec_headers": "Sec-Fetch-Dest:empty;Sec-Fetch-Mode:cors;Sec-Fetch-Site:cross-site;Content-Cache: no-cache",
  },
  "vidhideplus": { "type": "default" },
  "dinisglows": {
    "type": "default",
    "referrer": "full",
    "alt-used": true,
    "sec_headers": "Sec-Fetch-Dest:empty;Sec-Fetch-Mode:cors;Sec-Fetch-Site:same-origin",
  },
  "mivalyo": { "type": "default" },
  "dingtezuni": { "type": "default" },
  "bingezove": { "type": "default" },
  "ok.ru": { "type": "default" },
  "ansembed": { "type": "vidmoly", "modes": { "mpv": "direct" } },
  "morencius": { "type": "default" },
  "videzz": {
    "type": "vidoza",
    "mode": "proxy",
    "no-header": true,
    "ext": "mp4",
  },
  "vidoza": {
    "type": "vidoza",
    "mode": "proxy",
    "no-header": true,
    "ext": "mp4",
  },
  "sendvid": { "type": "sendvid", "mode": "proxy", "ext": "mp4" },
  "sibnet": {
    "type": "sibnet",
    "mode": "proxy",
    "ext": "mp4",
    "referrer": "full",
    "no-header": true,
  },
  "uqload": {
    "type": "default",
    "sec_headers": "Sec-Fetch-Dest:video;Sec-Fetch-Mode:no-cors;Sec-Fetch-Site:same-site",
    "ext": "mp4",
    "modes": { "mpv": "direct" }
  },
  "filemoon": {
    "type": "filemoon",
    "referrer": "https://ico3c.com/",
    "no-header": true,
  },
  "bysebuho": {
    "type": "filemoon",
    "referrer": "https://ico3c.com/",
    "no-header": true,
  },
  "bysekoze": {
    "type": "filemoon",
    "referrer": "https://ico3c.com/",
    "no-header": true,
  },
  "kakaflix": { "type": "kakaflix" },
  // "myvidplay": {"type": "myvidplay", "referrer": "https://myvidplay.com/"},
  "embed4me": { "type": "embed4me" },
  "coflix.upn": { "type": "embed4me" },
  "veev": {
    "type": "veev",
    "ext": "mp4",
  },
  "xtremestream": { "type": "xtremestream" },
  "montmyoboky": {"type": "montmyoboky", "modes": { "mpv": "direct" } },
  "vidzy": { "type": "vidzy", "referrer": "https://vidzy.org/" },
  "voe": { "type": "voe", "modes": { "mpv": "direct" } },
  "voe.sx": { "type": "voe", "modes": { "mpv": "direct" }},
  "jeremyparticipantanything": { "type": "voe", "modes": { "mpv": "direct" } },
  "teresapoliticallearn": { "type": "voe", "modes": { "mpv": "direct" } }
}
